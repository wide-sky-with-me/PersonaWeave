# Copy to .env and fill values locally. Never commit real credentials.
PERSONAWEAVE_AI_CONFIG=config/ai_gateway.yaml
PERSONAWEAVE_CORS_ORIGINS=http://localhost:3000

# Optional second LAN listener; see docs/docker-deployment.md.
# PERSONAWEAVE_LAN_ADDRESS=192.168.1.100
# COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml:docker-compose.lan.yml

# Independent services for visual analysis and image editing.
# Model IDs below are EXAMPLES, not a promise of service availability or compatibility.
# Set each URL/key locally and use the LiteLLM provider prefix supported by that service.
AI_VISION_MODEL=openai/gpt-4o
AI_VISION_API_BASE=
AI_VISION_API_KEY=

AI_IMAGE_MODEL=openai/gpt-image-1
AI_IMAGE_API_BASE=
AI_IMAGE_API_KEY=
