# Never commit a real key. Rotate any key pasted into chat or logs.
PERSONAWEAVE_YUNWU_API_KEY=
PERSONAWEAVE_YUNWU_BASE_URL=https://yunwu.ai/v1
PERSONAWEAVE_YUNWU_VISION_MODEL=gpt-5.6-sol
PERSONAWEAVE_YUNWU_VISION_API_MODE=chat_completions
PERSONAWEAVE_YUNWU_VISION_API_PATH=/chat/completions
# Formal delivery uses both independently configured reviewers. Both must be
# configured, and the model IDs must be distinct, to enable dual-review gating.
PERSONAWEAVE_YUNWU_REVIEWER_MODEL_A=
PERSONAWEAVE_YUNWU_REVIEWER_MODEL_B=
# Planning/review calls fail fast independently from the 600-second image execution window.
PERSONAWEAVE_MULTIMODAL_TIMEOUT_SECONDS=600
PERSONAWEAVE_ADVISORY_PREVIEW_MAX_EDGE=1600
# Model-native preview image profile. Do not infer an endpoint from the model
# name; configure the exact Yunwu API mode and path supported by the model.
PERSONAWEAVE_YUNWU_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
PERSONAWEAVE_YUNWU_IMAGE_API_MODE=json_generations
PERSONAWEAVE_YUNWU_IMAGE_API_PATH=/api/v3/images/generations
PERSONAWEAVE_YUNWU_IMAGE_SIZE=2K
PERSONAWEAVE_YUNWU_IMAGE_RESPONSE_FORMAT=url
PERSONAWEAVE_YUNWU_IMAGE_TIMEOUT_SECONDS=600
# Formal delivery is a separate, mask-aware profile and must use multipart edits.
PERSONAWEAVE_FORMAL_IMAGE_MODEL=gpt-image-2
PERSONAWEAVE_FORMAL_IMAGE_API_MODE=multipart_edits
PERSONAWEAVE_FORMAL_IMAGE_API_PATH=/images/edits
PERSONAWEAVE_FORMAL_IMAGE_SIZE=1024x1024
# Leave blank when the formal edit endpoint does not accept response_format.
PERSONAWEAVE_FORMAL_IMAGE_RESPONSE_FORMAT=
PERSONAWEAVE_FORMAL_IMAGE_TIMEOUT_SECONDS=600
PERSONAWEAVE_PREVIEW_STRATEGY=model_native
PERSONAWEAVE_PREVIEW_MAX_ITERATIONS=3

# Optional remote inference gateway. It can wrap hosted ComfyUI or another
# face-specific API while preserving PersonaWeave's provider contract.
PERSONAWEAVE_INFERENCE_BASE_URL=
PERSONAWEAVE_INFERENCE_API_KEY=

PERSONAWEAVE_DATABASE_PATH=./data/personaweave.sqlite3
PERSONAWEAVE_ASSET_ROOT=./data/assets
PERSONAWEAVE_WORKER_CONCURRENCY=2
# Concurrent multimodal calls while compiling identities, permissions, reference
# coverage, and semantic masks. Keep this within the provider's rate limit.
PERSONAWEAVE_CONTRACT_COMPILATION_CONCURRENCY=4
PERSONAWEAVE_MAX_UPLOAD_BYTES=26214400
PERSONAWEAVE_REQUEST_TIMEOUT_SECONDS=600

# Docker-only settings. The data root is the path inside the Linux container.
# Keep /app/data for new installations. Set it to a legacy file URI root when
# mounting an existing database whose assets were created at another path.
PERSONAWEAVE_CONTAINER_DATA_ROOT=/app/data
# Compatibility mount for databases created by the previous WSL workflow.
# Clear or change this only when the database has no file:// URIs under this path.
PERSONAWEAVE_LEGACY_DATA_ROOT=/mnt/e/yhr/workspace/PersonaWeave/data
PERSONAWEAVE_HTTP_PORT=8100
# Internal Docker Desktop host-network listener used behind the ingress proxy.
PERSONAWEAVE_INTERNAL_HTTP_PORT=8110
PERSONAWEAVE_MEMORY_LIMIT=2g
PERSONAWEAVE_CPU_LIMIT=2.0
PERSONAWEAVE_DOCKER_INFERENCE_BASE_URL=
PERSONAWEAVE_DOCKER_INFERENCE_API_KEY=
PERSONAWEAVE_GATEWAY_SHARED_KEY=
PERSONAWEAVE_COMFY_GATEWAY_PORT=8010

# Standalone ComfyUI gateway process. Cloud ComfyUI normally uses /api;
# self-hosted ComfyUI commonly uses an empty prefix.
PERSONAWEAVE_COMFY_BACKEND_URL=
PERSONAWEAVE_COMFY_BACKEND_API_PREFIX=/api
PERSONAWEAVE_COMFY_BACKEND_API_KEY=
PERSONAWEAVE_COMFY_GATEWAY_API_KEY=
PERSONAWEAVE_COMFY_WORKFLOW_DIR=./comfy-workflows
PERSONAWEAVE_COMFY_DATABASE_PATH=./data/comfy-gateway.sqlite3
PERSONAWEAVE_COMFY_ALLOWED_ASSET_HOSTS=
PERSONAWEAVE_COMFY_REQUEST_TIMEOUT_SECONDS=600
PERSONAWEAVE_COMFY_EXECUTION_TIMEOUT_SECONDS=600
PERSONAWEAVE_COMFY_POLL_INTERVAL_SECONDS=1
PERSONAWEAVE_COMFY_MAX_ASSET_BYTES=26214400
PERSONAWEAVE_COMFY_MAX_CONCURRENT_TRANSFERS=4

# Local development example (do not use 127.0.0.1 from inside a container):
# PERSONAWEAVE_COMFY_BACKEND_URL=http://127.0.0.1:8188
# PERSONAWEAVE_COMFY_BACKEND_API_PREFIX=
