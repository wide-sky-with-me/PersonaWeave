{
  "name": "mediapipe-targeted-face-analysis-v1",
  "version": 1,
  "model": "Comfy-Org/mediapipe:mediapipe_face_fp32",
  "prompt": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "{{source_image}}"
      }
    },
    "2": {
      "class_type": "PersonaWeaveRegionHintImageTiles",
      "inputs": {
        "image": ["1", 0],
        "regions_json": "{{region_hints_json}}",
        "tile_size": 768
      }
    },
    "3": {
      "class_type": "LoadMediaPipeFaceLandmarker",
      "inputs": {
        "model_name": "mediapipe_face_fp32.safetensors"
      }
    },
    "4": {
      "class_type": "MediaPipeFaceLandmarker",
      "inputs": {
        "face_detection_model": ["3", 0],
        "image": ["2", 0],
        "detector_variant": "both",
        "num_faces": 0,
        "min_confidence": 0.5,
        "missing_frame_fallback": "empty"
      }
    },
    "5": {
      "class_type": "PersonaWeaveFaceAnalysisJson",
      "inputs": {
        "bboxes": ["4", 1],
        "request_json": "{{request_json}}",
        "tiles_json": ["2", 1]
      }
    },
    "6": {
      "class_type": "PersonaWeaveJsonOutput",
      "inputs": {
        "text": ["5", 0]
      }
    }
  },
  "output": {
    "node_id": "6",
    "field": "text",
    "kind": "json"
  }
}
